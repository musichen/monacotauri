{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonacoTauri",
  "version": "0.1.0",
  "identifier": "com.musichen.monacotauri",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start:tauri",
    "devUrl": "http://localhost:4000",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MonacoTauri",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src blob: data: filesystem: ws: http: https: 'unsafe-eval' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A quick Tauri and Monaco Editor experiment"
  }
}
