{
  "name": "monacotauri",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "monaco-editor": "0.23.0",
    "react": "17.0.1",
    "react-color": "2.18.1",
    "react-dom": "17.0.1",
    "react-grid-layout": "1.2.0",
    "react-monaco-editor": "^0.42.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "monaco-editor-webpack-plugin": "^3.0.0",
    "babel-eslint": "^10.1.0",
    "eslint": "7.14.0",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-prettier": "3.1.4",
    "eslint-plugin-react": "7.21.5",
    "eslint-plugin-react-hooks": "4.2.0",
    "react-scripts": "4.0.0",
    "react-app-rewired": "^2.1.8"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider REACT_APP_IS_WEB_MODE=true react-app-rewired start",
    "start:tauri": "NODE_OPTIONS=--openssl-legacy-provider PORT=4000 react-app-rewired start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-app-rewired build",
    "tauri": "tauri",
    "bundle": "CI=true tauri build",
    "test": "react-app-rewired test",
    "eject": "react-app-rewired eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
